# Salin file ini menjadi .env, lalu isi nilainya. JANGAN dibagikan atau di-commit.

# Kunci sesi: gunakan nilai acak, misalnya dari: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_KUNCI_ACAK

# 0 untuk uji lokal (http). 1 jika sudah di belakang HTTPS.
CAPY_PRODUKSI=0
COOKIE_SECURE=0

# Domain frontend. Lokal: http://localhost:3000. Server: https://domainkamu
CORS_ORIGINS=http://localhost:3000

# 1 hanya jika ada reverse proxy (Caddy/Nginx) di depan aplikasi.
TRUST_PROXY=0

# Database SQLite (default)
DATABASE_URL=sqlite:///capy.db

# Ollama Cloud (Capy)
OLLAMA_URL=https://ollama.com/api/chat
OLLAMA_API_KEY=GANTI_DENGAN_KUNCI_OLLAMA
OLLAMA_MODEL=gpt-oss:20b-cloud
CAPY_MODEL_OBROLAN=gpt-oss:20b-cloud
CAPY_MODEL_ACARA=gpt-oss:20b-cloud

# Admin pertama (opsional). Dibuat otomatis saat pertama jalan jika belum ada admin.
# Setelah admin tercipta, HAPUS dua baris ini dari .env.
ADMIN_AWAL_USERNAME=
ADMIN_AWAL_PASSWORD=

# Batas pemakaian Capy
ASISTEN_MAKS_PER_MENIT=20
ASISTEN_KUOTA_HARIAN=200
